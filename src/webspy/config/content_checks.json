{
  "comment_flags": [
    {
      "pattern": "TODO|FIXME|HACK",
      "description": "developer note left in production markup"
    },
    {
      "pattern": "\\b(?:10|172|192)\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
      "description": "internal/private IP address reference"
    },
    {
      "pattern": "[\\w.\\-]+@[\\w\\-]+\\.[a-zA-Z]{2,}",
      "description": "email address"
    },
    {
      "pattern": "(?i)password|passwd|credential",
      "description": "mentions credentials"
    },
    {
      "pattern": "(?i)(staging|dev|internal)[.\\-]",
      "description": "reference to a non-production environment"
    }
  ],
  "sensitive_cache_keywords": [
    "admin",
    "account",
    "login",
    "profile",
    "dashboard",
    "checkout",
    "billing",
    "order",
    "api/user",
    "token",
    "session"
  ]
}
