  "cookie_flags": {
    "required": [
      "Secure",
      "HttpOnly",
      "SameSite"
    ],
    "prefixes": [
      "__Host-",
      "__Secure-"
    ],
    "session_cookie_name_hints": [
      "session",
      "sessid",
      "sid",
      "auth",
      "token",
      "jwt",
      "login",
      "remember",
      "csrf",
      "xsrf"
    ],
    "note": "Report session/auth cookies missing Secure (on HTTPS sites), HttpOnly, or SameSite; flag SameSite=None without Secure."
  },
  "tls_checks": {
    "flag_protocols": [
      "SSLv2",
      "SSLv3",
      "TLSv1.0",
      "TLSv1.1"
    ],
    "min_ok_protocol": "TLSv1.2",
    "flag_cert_days_remaining_below": 30,
    "flag_cert_self_signed": true,
    "flag_cert_hostname_mismatch": true,
    "flag_weak_signature": [
      "md5",
      "sha1"
    ],
    "flag_weak_key": {
      "rsa_bits_below": 2048,
      "ec_bits_below": 224
    },
    "note": "Active TLS probing is optional; these thresholds are for reporting only."
  },
  "cors_probe": {
    "origins": [
      "https://evil.example",
      "null",
      "https://{host}.evil.example",
      "https://evil.example.{host}"
    ],
    "note": "Send as Origin header with a normal GET; flag if the exact origin (or 'null') is reflected in Access-Control-Allow-Origin together with Access-Control-Allow-Credentials: true."
  },
  "host_header_probe": {
    "headers": [
      "X-Forwarded-Host",
      "X-Host",
      "X-Forwarded-Server",
      "Forwarded"
    ],
    "canary": "canary.invalid",
    "note": "Flag if the canary value is reflected in the body, Location header, or links (host header injection / cache poisoning indicator)."
  },
  "redirect_checks": {
    "http_to_https_expected": true,
    "max_chain_length_flag": 4,
    "flag_mixed_content": true,
    "flag_www_nonwww_inconsistency": true
  },
  "required_security_headers": [
    "Strict-Transport-Security",
    "Content-Security-Policy",
    "X-Frame-Options",
    "X-Content-Type-Options",
    "Permissions-Policy",
    "Referrer-Policy",
    "Cross-Origin-Opener-Policy",
    "Cross-Origin-Embedder-Policy",
    "Cross-Origin-Resource-Policy"
  ]
}
