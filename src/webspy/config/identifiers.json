{
  "_comment": "patterns: regexes that extract tracking/ad/pixel IDs (first non-empty capture group is the value). social_hosts: hosts whose links are reported as social profiles.",
  "patterns": {
    "google_analytics_ua": "\\bUA-\\d{4,10}-\\d{1,4}\\b",
    "google_analytics_4": "(?<![A-Za-z0-9_\\-])G-[A-Z0-9]{10}(?![A-Za-z0-9_\\-])",
    "google_tag_manager": "\\bGTM-[A-Z0-9]{4,8}\\b",
    "google_adsense_publisher": "\\b(?:ca-)?(pub-\\d{10,20})\\b",
    "google_ads_conversion": "\\bAW-\\d{6,12}\\b",
    "facebook_pixel": "fbq\\(\\s*[\"\\']init[\"\\']\\s*,\\s*[\"\\']?(\\d{8,20})",
    "hotjar_site_id": "\\bhjid\\s*[:=]\\s*(\\d+)",
    "yandex_metrika": "\\bym\\(\\s*(\\d{5,10})\\s*,|mc\\.yandex\\.(?:ru|com)/watch/(\\d+)",
    "microsoft_clarity": "clarity\\.ms/tag/([a-z0-9]{8,12})",
    "tiktok_pixel": "ttq\\.load\\(\\s*[\"\\']([A-Z0-9]{10,25})[\"\\']",
    "linkedin_partner_id": "_linkedin_partner_id\\s*=\\s*[\"\\']?(\\d+)",
    "pinterest_tag": "pintrk\\(\\s*[\"\\']load[\"\\']\\s*,\\s*[\"\\'](\\d+)",
    "twitter_pixel": "twq\\(\\s*[\"\\'](?:init|config)[\"\\']\\s*,\\s*[\"\\']([a-z0-9]+)",
    "segment_write_key": "analytics\\.load\\([\"\\']([A-Za-z0-9]{20,40})[\"\\']\\)",
    "mixpanel_token": "mixpanel\\.init\\(\\s*[\"\\']([0-9a-f]{32})",
    "hubspot_portal_id": "js\\.hs-scripts\\.com/(\\d+)\\.js",
    "sentry_dsn": "https://[0-9a-f]{32}@[\\w.\\-]+/\\d+",
    "recaptcha_site_key": "\\b(6L[A-Za-z0-9_\\-]{38})\\b",
    "ethereum_address": "\\b0x[a-fA-F0-9]{40}\\b",
    "bitcoin_bech32_address": "\\bbc1[a-z0-9]{39,59}\\b"
  },
  "social_hosts": [
    "facebook.com",
    "twitter.com",
    "x.com",
    "instagram.com",
    "linkedin.com",
    "youtube.com",
    "t.me",
    "telegram.me",
    "github.com",
    "tiktok.com",
    "pinterest.com",
    "reddit.com",
    "discord.gg",
    "discord.com",
    "wa.me",
    "medium.com",
    "threads.net",
    "mastodon.social",
    "bsky.app"
  ]
}
