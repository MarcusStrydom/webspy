{
  "patterns": [
    {
      "pattern": "AKIA[0-9A-Z]{16}",
      "label": "AWS Access Key ID"
    },
    {
      "pattern": "AIza[0-9A-Za-z\\-_]{35}",
      "label": "Google API Key"
    },
    {
      "pattern": "sk_live_[0-9a-zA-Z]{24,}",
      "label": "Stripe Live Secret Key"
    },
    {
      "pattern": "pk_live_[0-9a-zA-Z]{24,}",
      "label": "Stripe Live Publishable Key"
    },
    {
      "pattern": "ghp_[0-9A-Za-z]{36}",
      "label": "GitHub Personal Access Token"
    },
    {
      "pattern": "xox[baprs]-[0-9A-Za-z\\-]{10,}",
      "label": "Slack Token"
    },
    {
      "pattern": "eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+",
      "label": "JWT (may or may not be sensitive — inspect contents)"
    },
    {
      "pattern": "(?i)(api[_-]?key|apikey|secret[_-]?key|access[_-]?token)[\"\\']?\\s*[:=]\\s*[\"\\'][0-9a-zA-Z\\-_]{16,}[\"\\']",
      "label": "Generic key/token assignment"
    },
    {
      "pattern": "mongodb(\\+srv)?://[^\"\\'\\s]+",
      "label": "MongoDB connection string"
    },
    {
      "pattern": "postgres(ql)?://[^\"\\'\\s]+:[^\"\\'\\s]+@",
      "label": "Postgres connection string with credentials"
    },
    {
      "pattern": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+",
      "label": "Slack Webhook URL"
    },
    {
      "pattern": "https://discord(?:app)?\\.com/api/webhooks/\\d+/[\\w\\-]+",
      "label": "Discord Webhook URL"
    },
    {
      "pattern": "\\b\\d{8,10}:AA[0-9A-Za-z_\\-]{33}\\b",
      "label": "Telegram Bot Token"
    },
    {
      "pattern": "SG\\.[\\w\\-]{22}\\.[\\w\\-]{43}",
      "label": "SendGrid API Key"
    },
    {
      "pattern": "sk-ant-[A-Za-z0-9_\\-]{20,}",
      "label": "Anthropic API Key"
    },
    {
      "pattern": "sk-[A-Za-z0-9]{32,}",
      "label": "OpenAI-style API Key"
    },
    {
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
      "label": "Private key block"
    }
  ]
}
